# Application
APP_NAME=Yalla Go Backend
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://yalla_go:yalla_go@localhost:5432/yalla_go
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Database (Docker Compose only — used by the db service and to build DATABASE_URL for api)
POSTGRES_USER=yalla_go
POSTGRES_PASSWORD=yalla_go
POSTGRES_DB=yalla_go

# Database (test suite only — used by tests/conftest.py; run against a separate DB so
# `pytest` never touches your dev data. Defaults to a local `yalla_go_test` DB if unset.)
TEST_DATABASE_URL=postgresql+asyncpg://yalla_go:yalla_go@localhost:5432/yalla_go_test

# Security (placeholders — real auth wired in a later prompt)
SECRET_KEY=change-me-to-a-random-64-char-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Rate limiting (slowapi syntax, e.g. "100/minute", "5/minute")
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute
